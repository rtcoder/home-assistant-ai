# Dockerfile.server
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV OLLAMA_HOST=0.0.0.0

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libasound2-dev \
    curl \
    ca-certificates \
    gnupg \
    git \
    procps \
    zstd \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g openclaw@latest \
    && curl -fsSL https://ollama.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt || touch requirements.txt

# Copy project files
COPY server/ ./server/
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

# Create ollama models directory
RUN mkdir -p /root/.ollama/models

# Pull models during build (Warning: This will result in a very large image, ~60GB+)
# Using confirmed model names and robust waiting mechanism.
# Note: 'bielik' is replaced by its more specific name or qwen2.5 if missing.
RUN (ollama serve &) && \
    echo "Waiting for Ollama server to be ready..." && \
    until curl -s localhost:11434/api/tags > /dev/null; do sleep 2; done && \
    echo "Ollama server is ready. Pulling models..." && \
    ollama pull llama3.1:8b && \
    ollama pull qwen2.5:32b && \
    ollama pull llama3.1:70b-instruct-q3_K_M && \
    pkill -f ollama

# Run the application
ENTRYPOINT ["./entrypoint.sh"]
